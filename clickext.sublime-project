{
  "folders": [
    {
      "folder_exclude_patterns": ["*.egg-info", ".ruff_cache", ".pytest_cache", "__pycache__"],
      "path": "."
    }
  ],
  "settings": {
    "LSP": {
      "LSP-pylsp": {
        "enabled": false
      },
      "LSP-pyright": {
        "enabled": false
      },
      "LSP-ruff": {
        "enabled": true,
        "server_path": ".venv/bin/ruff"
      },
      "LSP-ty": {
        "enabled": true,
        "server_path": ".venv/bin/ty"
      },
      "ltex-ls": {
        "settings": {
          "ltex.dictionary": {
            "en-US": ["clickext", "subcommand", "subcommands", "unaliased"]
          }
        }
      }
    }
  }
}
