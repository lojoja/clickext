{
  "folders": [
    {
      "folder_exclude_patterns": ["*.egg-info", ".pytest_cache", "__pycache__"],
      "path": "."
    }
  ],
  "settings": {
    "LSP": {
      "LSP-pylsp": {
        "settings": {
          "pylsp.plugins.pylint.executable": ".venv/bin/pylint"
        }
      },
      "ltex-ls": {
        "settings": {
          "ltex.dictionary": {
            "en-US": ["clickext", "subcommand", "subcommands", "unaliased"]
          }
        }
      }
    }
  }
}
